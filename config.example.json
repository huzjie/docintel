{
  "provider": "mock",
  "providers": {
    "openai": { "api_key": "", "base_url": "https://api.openai.com/v1", "model": "gpt-4o-mini" },
    "deepseek": { "api_key": "", "base_url": "https://api.deepseek.com/v1", "model": "deepseek-chat" },
    "qwen": { "api_key": "", "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1", "model": "qwen-plus" },
    "ollama": { "base_url": "http://localhost:11434", "model": "qwen2.5:7b" }
  },
  "pipeline": {
    "enable_layout": true,
    "enable_table": true,
    "enable_ocr": true,
    "enable_chunk": true,
    "enable_extract": false,
    "extract_schema": "contract",
    "chunk_size": 800,
    "chunk_overlap": 120,
    "output_formats": ["markdown", "json"]
  },
  "ocr": { "engine": "mock", "tesseract_cmd": "tesseract", "lang": "chi_sim+eng" },
  "extract": { "max_tokens": 2048, "temperature": 0.0, "retries": 2 },
  "security": { "max_file_mb": 50, "max_pages": 500, "enable_pii_redact": true, "pii_placeholder": "[REDACTED]" },
  "storage": { "type": "sqlite", "path": ".docintel/data.db" },
  "server": { "host": "0.0.0.0", "port": 8000 }
}
